{
  "name": "ancestral-abode",
  "version": "1.0.0",
  "description": "Ancestral Abode — A Boutique Homestay. Luxury homestay website with a Node.js/Express/MySQL booking engine.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build.js",
    "db:setup": "node scripts/setup-db.js",
    "db:reset": "node scripts/setup-db.js --fresh",
    "lint": "eslint .",
    "test": "node --test tests/",
    "test:watch": "node --test --watch tests/"
  },
  "keywords": [
    "homestay",
    "heritage",
    "express",
    "mysql",
    "booking"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.3",
    "nodemailer": "^10.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "supertest": "^7.0.0"
  }
}
