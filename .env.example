# Ancestral Abode — environment configuration
# Copy to .env and adjust for your machine.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3311
DB_USER=root
DB_PASSWORD=
DB_NAME=homestay_db
DB_POOL_SIZE=10

# Booking rules
MAX_ADVANCE_NIGHTS=730
MAX_STAY_NIGHTS=30
SERVICE_FEE_PERCENT=6
TAX_PER_NIGHT=500
BOOKING_HOLD_MINUTES=15

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Admin Panel Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AncestralAbode@2026
JWT_SECRET=ancestral-abode-secret-key-1892

# Email / SMTP System (leave empty for in-memory development mock)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Ancestral Abode Jaipur" <ancestralabodehomestay@gmail.com>
ADMIN_NOTIFICATION_EMAIL=ancestralabodehomestay@gmail.com
